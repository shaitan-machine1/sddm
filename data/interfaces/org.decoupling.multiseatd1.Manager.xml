<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.decoupling.multiseatd1.Manager">
    <method name="ListSeats">
      <arg name="seats" type="as" direction="out"/>
    </method>
    <method name="CreateClient">
      <arg name="seat_name" type="s" direction="in"/>
      <arg name="uid" type="u" direction="in"/>
      <arg name="client_id" type="s" direction="out"/>
      <arg name="fd" type="h" direction="out"/>
    </method>
    <method name="RevokeClient">
      <arg name="client_id" type="s" direction="in"/>
    </method>
    <signal name="SeatNew">
      <arg name="seat" type="s"/>
    </signal>
    <signal name="SeatRemoved">
      <arg name="seat" type="s"/>
    </signal>
  </interface>
</node>
